# Environment configuration for Travel Genie.
# Copy to `.env` and fill in real values. Never commit `.env` (it is git-ignored).
#
# Canonical location: repository-root `.env` (a single source; backend/.env is
# not read). Values already exported in the shell take precedence over the file.
# These variables are read by app/core/config.py; presence (never the value) is
# surfaced by /api/health. Leave them empty to run without live integrations.

# Logging verbosity for the travel_genie logger: DEBUG | INFO | WARNING
LOG_LEVEL=INFO

# Structured-extraction LLM provider: stub | gemini | groq
# - stub   : deterministic local response, no network (default; no credentials needed)
# - gemini : Google Gemini (requires GEMINI_API_KEY)
# - groq   : Groq (requires GROQ_API_KEY)
# Selection is explicit and there is no automatic fallback: the configured
# provider is used for every extraction call. Shell exports win over this file.
LLM_PROVIDER=stub

# Gemini (primary LLM provider, wired this milestone)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=35
GEMINI_MAX_OUTPUT_TOKENS=8192

# Groq (alternative LLM provider, wired this milestone)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=35
GROQ_MAX_OUTPUT_TOKENS=8192

# SerpApi (live destination discovery for the Explore page; wired this milestone).
# Without this key /api/discover returns 503 discovery_unavailable instead of
# fabricating results.
SERPAPI_API_KEY=
SERPAPI_TIMEOUT_SECONDS=15
